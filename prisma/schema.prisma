generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  clerkId       String   @unique
  email         String   @unique
  name          String
  role          String   @default("STUDENT")
  classBalance  Int      @default(0)
  createdAt     DateTime @default(now())
}

model Module {
  id            String   @id @default(uuid())
  title         String
  aiContent     String   
  createdAt     DateTime @default(now())
}